# Hosted mode (optional). When set, MCP routes to a hosted npad server.
# NPAD_API_KEY=npad_xxxxxxxxxxxxxxxxxxxxxxxx
# NPAD_API_URL=https://npad.ai

# Local SQLite path override (optional, defaults to ~/.npad/npad.db)
# NPAD_DB_PATH=/absolute/path/to/npad.db

# --- server package only ---
# DATABASE_URL=postgres://user:pass@host/db
# PORT=8787

# Firebase Admin credentials. Provide ONE of these:
#   FIREBASE_SERVICE_ACCOUNT      — full JSON string (use this on Vercel)
#   FIREBASE_SERVICE_ACCOUNT_PATH — file path (use this for local dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-admin.json
