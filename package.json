{
  "name": "npad",
  "version": "0.1.0",
  "private": true,
  "description": "A notepad your agents read and write to.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @npad/server dev",
    "dev:mcp": "pnpm --filter @npad/mcp dev",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.28.2"
}
