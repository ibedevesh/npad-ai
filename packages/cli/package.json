{
  "name": "@npad/cli",
  "version": "0.2.2",
  "description": "npad CLI — manage your AI agent notes from the terminal.",
  "license": "MIT",
  "homepage": "https://npad.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibedevesh/npad-ai.git",
    "directory": "packages/cli"
  },
  "keywords": ["mcp", "npad", "ai", "agents", "cli", "notes"],
  "type": "module",
  "bin": {
    "npad": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "@npad/core": "workspace:*",
    "@npad/mcp": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
