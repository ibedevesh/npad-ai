{
  "name": "@npad/core",
  "version": "0.2.5",
  "description": "Core types and utilities for npad — a notepad for AI agents.",
  "license": "MIT",
  "homepage": "https://npad.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibedevesh/npad-ai.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
