{
  "name": "@npad/mcp",
  "version": "0.2.1",
  "description": "MCP server for npad — exposes note_write/read/search tools to any MCP-compatible AI agent.",
  "license": "MIT",
  "homepage": "https://npad.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibedevesh/npad-ai.git",
    "directory": "packages/mcp"
  },
  "keywords": ["mcp", "npad", "ai", "agents", "claude", "notes"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "npad-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite-store": {
      "types": "./dist/stores/sqlite.d.ts",
      "import": "./dist/stores/sqlite.js"
    },
    "./http-store": {
      "types": "./dist/stores/http.d.ts",
      "import": "./dist/stores/http.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@npad/core": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
