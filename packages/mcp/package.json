{
  "name": "@npad/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "npad-mcp": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sqlite-store": "./src/stores/sqlite.ts",
    "./http-store": "./src/stores/http.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@npad/core": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
